// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
}

//Core data models 
model Account {
  id           String   @id @default(cuid())
  connectionId String   @unique
  displayName  String
  displayImage String?
  neupId       String   @unique
  status       String   @default("ACTIVE")
  isVerified   Boolean  @default(false)
  details      Json?
  createdAt    DateTime @default(now())

  articles  Article[]
  comments  Comment[]
  reactions Reaction[]

  @@map("account")
}

model Article {
  id        String   @id @default(cuid()) // Maps to post.id
  title     String                        // Maps to post.title
  slug      String   @unique
  content   String   @db.Text
  likes     Int      @default(0)          // Maps to post.likes / initialLikes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  authorId  String
  author    Account   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[] // Maps to post.comments in <CommentSection />
  reactions Reaction[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  authorId  String
  author    Account  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model Reaction {
  id        String   @id @default(cuid())
  type      String   @default("LIKE")
  createdAt DateTime @default(now())

  // Relationships
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([accountId, articleId, type])
}
