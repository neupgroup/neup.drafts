// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
}

//Core data models 
model Account {
  id            String    @id @default(cuid()) @db.VarChar(255)
  neupId        String?   @unique @db.VarChar(255)
  connectionId  String    @unique @db.VarChar(255)
  type          String    @db.VarChar(255)
  displayName   String    @db.VarChar(255)
  displayImage  String?   @db.VarChar(255)
  createdOn     DateTime  @default(now())
  status        String    @default("ACTIVE") @db.VarChar(255)
  isVerified Boolean @default(false)
  moreDetails   Json?

  articles  Article[]
  comments  Comment[]
  reactions Reaction[]
  authzAccess AuthzAccess[]
  roles         Role[]        // Added this opposite relation

  @@map("account")
}

model Article {
  id        String   @id @default(cuid()) // Maps to post.id
  title     String                        // Maps to post.title
  slug      String   @unique
  content   String   @db.Text
  likes     Int      @default(0)          // Maps to post.likes / initialLikes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  authorId  String
  author    Account   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[] // Maps to post.comments in <CommentSection />
  reactions Reaction[]
  authzAccess AuthzAccess[]
}

model ArticleAuthor {
  id        String @id @default(cuid())
  articleId String @map("article_id")
  authorId  String @map("author_id")
  role      String
  status    String

  @@map("article_authors")
}

model AuthzAccess {
  id        String   @id @default(cuid())
  accountId String   @map("account_id")
  articleId String?  @map("article_id")
  projectId String?  @map("project_id")
  roleId    String   @map("role_id")
  createdOn DateTime @default(now()) @map("created_on")
  status    String   @default("ACTIVE")

  // Relationships
  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("authz_access")
}

model AuthzRole {
  id          String   @id @default(cuid())
  name        String
  permissions Json?
  syncedOn    DateTime @default(now()) @map("synced_on")

// Opposite relation fields required by Prisma
  roles       Role[]
  access      Access[]

  @@map("authz_role")
}

model Role {
  id            String   @id @default(cuid()) @db.VarChar(255)
  memberId      String   @map("member_id") @db.VarChar(255)
  accountId     String?  @map("account_id") @db.VarChar(255)
  connectionId  String?  @map("connection_id") @db.VarChar(255)
  assetId       String?  @map("asset_id") @db.VarChar(255)
  assetType     String?  @map("asset_type") @db.VarChar(255)
  assetIdDenorm String?  @map("asset_id_denorm") @db.VarChar(255)
  roleId        String   @map("role_id") @db.VarChar(255)
  roleName      String?  @map("role_name") @db.VarChar(255)
  permissions   Json?
  status        String   @default("ACTIVE") @db.VarChar(255)
  details       Json?

  // Active relations based on your existing models
  account Account?   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role    AuthzRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([accountId])
  @@index([connectionId])
  @@index([assetId])
  @@index([roleId])
  @@map("role")
}

model Access {
  id              String    @id @default(cuid()) @db.VarChar(255)
  accessType      String    @map("access_type") @db.VarChar(255)
  memberAccountId String?   @map("member_account_id") @db.VarChar(255)
  parentAccountId String?   @map("parent_account_id") @db.VarChar(255)
  isTemporary     DateTime? @map("is_temporary")
  roleId          String    @map("role_id") @db.VarChar(255)
  status          String    @default("ACTIVE") @db.VarChar(255)

  // Relationship to AuthzRole
  role AuthzRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([memberAccountId])
  @@index([parentAccountId])
  @@index([roleId])
  @@map("access")
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  authorId  String
  author    Account  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model Reaction {
  id        String   @id @default(cuid())
  type      String   @default("LIKE")
  createdAt DateTime @default(now())

  // Relationships
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([accountId, articleId, type])
}
